DJANGO_SECRET_KEY=replace-with-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
OPENWEATHER_API_KEY=
DEFAULT_CITY_WEATHER=Minsk
DEFAULT_USER_TIMEZONE=Europe/Minsk

# Render usually gives one DATABASE_URL automatically.
# For local Docker Compose use POSTGRES_* variables from docker-compose.yml.
DATABASE_URL=

# Do not enable demo users in production.
DJANGO_LOAD_DEMO_DATA=False
DJANGO_CREATE_DEMO_USERS=False
DJANGO_CREATE_DEMO_ADMIN=False

DJANGO_SERVE_MEDIA_FILES=True
